# ============================================
# Customer Support AI - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# OpenAI API Key (Required)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Supabase Configuration (Optional - for database features)
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key-here

# AWS Configuration (Optional - for deployment only)
AWS_REGION=ap-south-1

# PostgreSQL Direct Connection (Alternative to Supabase client)
# Use this if you prefer direct PostgreSQL connection string
# DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres

